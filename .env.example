# PayPal Sandbox credentials — https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
SECRET_KEY=replace-with-a-long-random-string
WEBHOOK_ID=your_paypal_webhook_id_here
BASE_URL=https://your-static-ngrok-domain.ngrok-free.app

# Populated by setup_plans.py
PLAN_ID_BASIC=
PLAN_ID_PRO=

# Optional overrides
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Listen address — change PORT if 5000 is taken
PORT=5000
HOST=0.0.0.0

# Port scanning (used by /setup page and startup log)
SCAN_HOSTS=localhost,host.docker.internal,172.17.0.1
SCAN_PORTS=5000,5001,5002,8000,8080,3000
SCAN_TIMEOUT=0.35

# CORS allowlist for Pages probing
CORS_PAGES_ORIGIN=https://swipswaps.github.io

# Require login for /setup (recommended for exposed deployments)
SETUP_REQUIRES_LOGIN=0

# White-label overrides (managed by the Pages config-builder)
BRAND_NAME=Demo SaaS
BRAND_TAGLINE=Sandbox subscription billing with PayPal Server SDK and Flask.
TIER_BASIC_NAME=Basic Tier
TIER_BASIC_PRICE=9.99
TIER_PRO_NAME=Pro Tier
TIER_PRO_PRICE=29.99
CURRENCY_CODE=USD
CURRENCY_SYMBOL=$
BILLING_INTERVAL=MONTH
